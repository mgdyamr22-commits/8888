{
  "name": "almakhzoun_inventory_pro",
  "private": true,
  "version": "3.5.1",
  "main": "main.js",
  "productName": "المخزون برو",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHENAWY12/almakhzoun.git"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:hosting": "tsc && vite build && node package-hosting.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "electron-dev": "electron .",
    "app": "npm run build && electron .",
    "dist": "node pre-build-clean.js && npm run build && electron-builder",
    "build:exe": "node pre-build-clean.js && npm run build && electron-builder --win",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.15.0",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.39.0",
    "multer": "^2.2.0",
    "mysql2": "^3.24.1",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/jszip": "^3.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.myapp.desktop",
    "productName": "MyApp",
    "copyright": "Copyright © 2026 Karian Digital Platform",
    "extraResources": [
      "public/about_karian.txt"
    ],
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SHENAWY12",
        "repo": "almakhzoun"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyApp",
      "runAfterFinish": true,
      "unicode": true,
      "language": "1025",
      "license": "public/about_karian.txt",
      "artifactName": "${productName}_Setup_${version}.${ext}"
    }
  }
}